# SchoolarTask Backend - Environment Variables Template

# Database
MONGO_URI=mongodb://localhost:27017/schoolartask

# JWT Secret (GENERAR UN NUEVO SECRET ALEATORIO)
# Para generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_64_characters_minimum

# Google OAuth (REGENERAR CREDENCIALES EN GOOGLE CLOUD CONSOLE)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:3000/oauth

# Frontend URL
FRONT_URL=http://localhost:5173

# Email / SMTP (opcional): usado para enviar el enlace de reset de contraseña.
# Si no se define, el envío se omite (el token se loguea fuera de producción para poder probar).
# Funciona con cualquier proveedor SMTP (Resend, SendGrid, Mailtrap, Gmail, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SchoolarTask <no-reply@schoolartask.com>

# Server
PORT=3000
NODE_ENV=development
